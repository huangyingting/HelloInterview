{
  "name": "interview-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": "npm run content:metadata && next dev",
    "build:next": "npm run content:metadata && npm run prisma:generate && next build",
    "start:next": "next start",
    "prisma:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://localhost/unavailable}\" prisma generate",
    "prisma:pull": "prisma db pull && prisma generate",
    "dev": "npm run content:metadata && tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run content:metadata && tsc --noEmit && vite build && npm run build:server",
    "content:metadata": "tsx scripts/generate-public-content.ts",
    "build:server": "esbuild server/index.ts server/db/cli.ts server/jobs/index.ts server/identity/cli.ts server/billing/cli.ts server/staff/cli.ts server/privacy/cli.ts server/preflight/cli.ts server/usage/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-server --outbase=server && tsx scripts/copy-private-media.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/index.js",
    "test": "playwright test",
    "test:unit": "tsx --test tests/config.test.ts tests/deployment.test.ts tests/domain.test.ts tests/premium.test.ts tests/content.test.ts tests/coding.test.ts tests/low-level-design.test.ts tests/access.test.ts tests/usage-calendar.test.ts tests/web-vitals.test.ts",
    "test:server": "npm run build && tsx --test tests/server.test.ts",
    "test:runtime": "npm run build && tsx --test tests/runtime.test.ts",
    "test:ai": "npm run build && tsx --test tests/ai.test.ts",
    "test:db": "npm run build && tsx --test tests/database.test.ts",
    "test:content": "npm run build && tsx --test tests/content-boundary.test.ts",
    "test:jobs": "npm run build && tsx --test tests/jobs.test.ts",
    "test:identity": "npm run build && tsx --test tests/identity.test.ts tests/identity-limits.test.ts tests/identity-contract.test.ts tests/identity-lifecycle.test.ts tests/identity-runtime.test.ts tests/staff.test.ts",
    "test:identity-browser": "npm run build && tsx --test tests/identity-browser.test.ts",
    "test:entitlements": "npm run build && tsx --test tests/entitlements.test.ts",
    "test:usage": "npm run build && tsx --test tests/usage.test.ts",
    "test:support": "npm run build && tsx --test tests/support.test.ts",
    "test:community": "npm run build && tsx --test tests/community.test.ts",
    "test:screens": "npm run build && tsx --test tests/screen-loading.test.ts",
    "test:billing": "npm run build && tsx --test tests/billing.test.ts tests/billing-checkout.test.ts tests/billing-ledger.test.ts tests/billing-payments.test.ts tests/billing-service.test.ts tests/billing-cancellation.test.ts tests/billing-portal.test.ts tests/billing-resumption.test.ts tests/billing-recheckout.test.ts",
    "test:billing-browser": "npm run build && tsx --test tests/billing-browser.test.ts",
    "test:container": "tsx --test tests/container.test.ts",
    "db:migrate": "node --env-file-if-exists=.env dist-server/db/cli.js migrate",
    "db:import": "node --env-file-if-exists=.env dist-server/db/cli.js import",
    "jobs:status": "node --env-file-if-exists=.env dist-server/db/cli.js jobs status",
    "jobs:replay": "node --env-file-if-exists=.env dist-server/db/cli.js jobs replay",
    "identity:reconcile": "node --env-file-if-exists=.env dist-server/identity/cli.js reconcile",
    "identity:worker": "node --env-file-if-exists=.env dist-server/identity/cli.js worker",
    "billing:reconcile": "node --env-file-if-exists=.env dist-server/billing/cli.js reconcile",
    "billing:worker": "node --env-file-if-exists=.env dist-server/billing/cli.js worker",
    "staff:role": "node --env-file-if-exists=.env dist-server/staff/cli.js",
    "privacy:process": "node --env-file-if-exists=.env dist-server/privacy/cli.js process",
    "privacy:worker": "node --env-file-if-exists=.env dist-server/privacy/cli.js worker",
    "service:preflight": "node --env-file-if-exists=.env dist-server/preflight/cli.js",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "media": "node scripts/generate-media.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.1",
    "next-auth": "^4.24.15",
    "openid-client": "6.8.8",
    "pg": "^8.16.3",
    "pg-boss": "12.37.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "stripe": "23.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
