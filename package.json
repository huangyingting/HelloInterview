{
  "name": "interview-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/index.js",
    "test": "playwright test",
    "test:unit": "tsx --test tests/config.test.ts tests/domain.test.ts tests/premium.test.ts tests/content.test.ts tests/coding.test.ts tests/low-level-design.test.ts",
    "test:server": "npm run build && tsx --test tests/server.test.ts",
    "test:runtime": "npm run build && tsx --test tests/runtime.test.ts",
    "test:ai": "npm run build && tsx --test tests/ai.test.ts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "media": "node scripts/generate-media.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
