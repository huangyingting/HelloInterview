# NODE_ENV defaults to development; npm start selects compiled static serving.
# Runtime settings are validated at startup. Demo accounts/plans remain local.
APP_MODE=local
# APP_MODE=service is only for the approved private beta and requires every
# service setting documented in docs/production/57-invite-only-service-runtime.md.
HOST=127.0.0.1
# Use 0 for an ephemeral port in isolated tests.
PORT=3000
DATA_DIR=data
# RETAINED_FRONTEND_DIRS=/releases/previous:/releases/older
# Optional PostgreSQL. Omit this setting entirely to retain local SQLite.
# Apply controlled migrations before starting; never point tests at customer data.
# DATABASE_URL=postgresql://studio_user:replace-me@127.0.0.1:5432/interview_studio
# Exactly true or false; use true only with HTTPS.
COOKIE_SECURE=false
# Optional canonical origin. HTTPS requires COOKIE_SECURE=true.
# PUBLIC_ORIGIN=https://studio.example.com
# Trust only the actual ingress IP/CIDR; never use true, a hop count, or /0.
# TRUST_PROXY=192.0.2.10
# Defaults to true for compiled production serving and false for development.
# LOG_REQUESTS=true
# Default off. Emits only allowlisted, normalized LCP/CLS/INP dimensions.
# FIELD_METRICS_ENABLED=true
# Private managed identity configuration. Never commit real tenant secrets or
# participant addresses. Service mode additionally requires the lifecycle,
# explicit proxy trust, request logs, and a non-empty invite list.
# OIDC_ISSUER=https://your-tenant.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_EMAIL_CONNECTION=Username-Password-Authentication
# OIDC_GOOGLE_CONNECTION=google-oauth2
# OIDC_GITHUB_CONNECTION=github
# OIDC_MANAGEMENT_ORIGIN=https://your-tenant.example.com
# OIDC_MANAGEMENT_CLIENT_ID=
# OIDC_MANAGEMENT_CLIENT_SECRET=
# OIDC_PASSWORD_HOOK_SECRET=
# OIDC_INVITED_EMAILS=beta-user@example.com
# Default-off restricted sandbox Portal. Requires the complete managed identity
# and own-account test billing settings in docs/production/20-restricted-sandbox-portal.md.
# Never use an unrestricted/default Portal or live customer configuration.
# STRIPE_TEST_PORTAL_CONFIGURATION=bpc_OperatorRestrictedTestConfiguration

# Optional. This is never populated from the reference-site credential file.
# Questions, selected lesson context, and submitted practice responses will be
# sent to this provider when configured.
# The base URL cannot contain credentials, query parameters, or a fragment.
# Remove every OPENAI_* and AZURE_OPENAI_* entry when using APP_MODE=service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Alternatively remove every OPENAI_* setting and configure Azure as one set:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
