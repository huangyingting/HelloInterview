# Next.js standalone listener and PostgreSQL persistence.
# Apply controlled migrations with `npm run db:migrate` before starting; never
# point development or test commands at customer data.
HOSTNAME=127.0.0.1
PORT=3000
# DATABASE_URL=postgresql://studio_user:replace-me@127.0.0.1:5432/interview_studio
# Trust only the actual ingress IP/CIDR; never use true, a hop count, or /0.
# TRUST_PROXY=127.0.0.1

# Auth.js password/social identity and app-owned TOTP MFA.
# Each social provider is optional; leave its complete pair absent or empty.
# Generate the MFA key once with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Never commit real provider secrets or participant email addresses.
# NEXTAUTH_URL=https://interview.genisisiq.com
# NEXTAUTH_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_FACEBOOK_CLIENT_ID=
# AUTH_FACEBOOK_CLIENT_SECRET=
# AUTH_INVITED_EMAILS=beta-user@example.com
# AUTH_MFA_ENCRYPTION_KEY=

# Invite-only account admission, password credentials, and outbox mail worker.
# Bootstrap the initial administrator with:
#   npm run build:workers
#   npm run bootstrap:admin -- --email admin@example.com --password-stdin
# ACCOUNT_ADMISSION_MODE=invitation-only
# ACCOUNT_ADMISSION_RETENTION_DAYS=30
# ACCOUNT_MAIL_WORKFLOW_ENABLED=false
# ACCOUNT_MAIL_WORKER_SECRET=
# RESEND_API_KEY=
# ACCOUNT_MAIL_FROM=Interview Studio <noreply@example.com>
# Start `npm run account-mail:worker` only after verifying your Resend sender.
# ACCOUNT_MAIL_WORKER_SECRET is required only for the external claim/ack API.
# Publishing requires explicit moderation/operator approval; removal/reporting
# remain available while publishing is paused.
# COMMUNITY_WRITES_ENABLED=false

# Required public participant terms for production serving.
# PRIVACY_CONTROLLER_NAME=Your legal operator name
# PRIVACY_CONTACT_URL=https://example.com/privacy-contact
# PARTICIPANT_MINIMUM_AGE=18
# PRIVACY_RETENTION_NOTICE=Describe the approved retention periods in participant-facing language.
# PRIVACY_DELETION_NOTICE=Describe the approved physical-deletion process and timeline.
# PRIVATE_BETA_NO_DURABILITY_ACK=true

# Optional sandbox billing. Requires Auth.js and PostgreSQL.
# Never use an unrestricted/default Portal or live customer configuration.
# STRIPE_TEST_ACCOUNT_ID=acct_your_test_account
# STRIPE_TEST_SECRET_KEY=rk_test_your_restricted_key
# STRIPE_TEST_WEBHOOK_SECRET=whsec_your_endpoint_secret
# STRIPE_TEST_OFFERS={"pro_monthly":"price_your_monthly_test_price","pro_annual":"price_your_annual_test_price"}
# STRIPE_TEST_ACCESS_POLICY=sandbox-card-service-v1
# STRIPE_TEST_PORTAL_CONFIGURATION=bpc_OperatorRestrictedTestConfiguration

# Optional managed Next.js AI worker (all-or-nothing authority).
# Prices are integer micro-dollars per one million provider-reported tokens.
# Never copy provider credentials into source, documentation, logs, issues, or release artifacts.
# MANAGED_AI_ENABLED=true
# MANAGED_AI_MODEL_REVISION=
# MANAGED_AI_INPUT_PRICE_MICROS_PER_MILLION_TOKENS=
# MANAGED_AI_OUTPUT_PRICE_MICROS_PER_MILLION_TOKENS=
# MANAGED_AI_DATA_USE_NOTICE=Explain which saved input is sent to Azure and the approved provider retention boundary.
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
