# NODE_ENV defaults to development; npm start selects compiled static serving.
# Runtime settings are validated at startup. Demo accounts/plans remain local.
HOST=127.0.0.1
# Use 0 for an ephemeral port in isolated tests.
PORT=3000
DATA_DIR=data
# Exactly true or false; use true only with HTTPS.
COOKIE_SECURE=false

# Optional. This is never populated from the reference-site credential file.
# Questions, selected lesson context, and submitted practice responses will be
# sent to this provider when configured.
# The base URL cannot contain credentials, query parameters, or a fragment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
