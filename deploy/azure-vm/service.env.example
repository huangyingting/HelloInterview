# Install as /etc/interview-studio/service.env with root:root ownership and mode 0600.
# Do not create this file until the real tenant, private-beta invite list and
# participant-facing privacy facts have been approved.
NEXTAUTH_URL=https://interview.genisisiq.com
NEXTAUTH_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=
AUTH_INVITED_EMAILS=
AUTH_MFA_ENCRYPTION_KEY=
# Transitional identity-lifecycle worker settings. Remove with the legacy
# OIDC worker unit before enabling the final Auth.js-only release.
OIDC_ISSUER=https://your-tenant.example.com/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EMAIL_CONNECTION=Username-Password-Authentication
OIDC_GOOGLE_CONNECTION=google-oauth2
OIDC_GITHUB_CONNECTION=github
OIDC_MANAGEMENT_ORIGIN=https://your-tenant.example.com
OIDC_MANAGEMENT_CLIENT_ID=
OIDC_MANAGEMENT_CLIENT_SECRET=
OIDC_PASSWORD_HOOK_SECRET=
OIDC_INVITED_EMAILS=
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_URL=
PARTICIPANT_MINIMUM_AGE=18
PRIVACY_RETENTION_NOTICE=
PRIVACY_DELETION_NOTICE=
PRIVATE_BETA_NO_DURABILITY_ACK=true
