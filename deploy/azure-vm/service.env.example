# Install as /etc/interview-studio/service.env with root:root ownership and mode 0600.
# Do not create this file until the real tenant, private-beta invite list and
# participant-facing privacy facts have been approved.
NEXTAUTH_URL=https://interview.genisisiq.com
NEXTAUTH_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=
AUTH_INVITED_EMAILS=
AUTH_MFA_ENCRYPTION_KEY=
# Leave both values of an OAuth provider empty to disable that provider.
# Invitations are managed in PostgreSQL; the static email list is optional.
ACCOUNT_ADMISSION_MODE=invitation-only
COMMUNITY_WRITES_ENABLED=false
# Enable only after configuring Resend and starting the account mail worker.
ACCOUNT_MAIL_WORKFLOW_ENABLED=false
# RESEND_API_KEY=
# ACCOUNT_MAIL_FROM=Interview Studio <noreply@example.com>
# ACCOUNT_MAIL_WORKER_SECRET=  # Only for the optional external claim/ack API.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_URL=
PARTICIPANT_MINIMUM_AGE=18
PRIVACY_RETENTION_NOTICE=
PRIVACY_DELETION_NOTICE=
PRIVATE_BETA_NO_DURABILITY_ACK=true
